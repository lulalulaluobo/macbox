{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MacNAS",
  "version": "0.1.0",
  "identifier": "com.macnas.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MacNAS",
        "width": 1280,
        "height": 860,
        "minWidth": 980,
        "minHeight": 680,
        "visible": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "externalBin": ["binaries/macnas"],
    "resources": {
      "../../templates": "templates"
    },
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
