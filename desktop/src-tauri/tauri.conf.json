{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MacBox",
  "version": "0.1.0",
  "identifier": "com.macbox.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MacBox",
        "width": 1280,
        "height": 860,
        "minWidth": 980,
        "minHeight": 680,
        "visible": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "externalBin": ["binaries/macbox"],
    "resources": {
      "../../templates": "templates"
    },
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
