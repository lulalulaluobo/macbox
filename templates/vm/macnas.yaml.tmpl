# MacNAS Lima VM 配置文件模板
# 采用 Apple Virtualization.framework (vz) 原生轻量虚拟化

minimumLimaVersion: 2.0.0

# Keep the internal Lima management identity independent from the macOS user.
# This account is only used by limactl; remote administration remains root
# key-only and the MacNAS console account remains admin.
user:
  name: macnasctl
  comment: MacNAS Lima management
  home: /home/macnasctl
  shell: /bin/bash
  passwordlessSudo: true

vmType: "vz"
vmOpts:
  vz:
    rosetta:
      enabled: true
      binfmt: true

images:
- location: "https://cloud-images.ubuntu.com/releases/24.04/release/ubuntu-24.04-server-cloudimg-arm64.img"
  arch: "aarch64"
- location: "https://cloud-images.ubuntu.com/releases/24.04/release/ubuntu-24.04-server-cloudimg-amd64.img"
  arch: "x86_64"

cpus: {{.CPUs}}
memory: "{{.Memory}}GiB"
disk: "{{.DiskSize}}GiB"

{{if .DataDiskName}}
additionalDisks:
- name: {{yamlQuote .DataDiskName}}
  format: true
  fsType: "ext4"
{{end}}

mountType: "virtiofs"
{{if .LocalMounts}}
mounts:
{{range .LocalMounts}}
{{if .Enabled}}
- location: {{yamlQuote .HostPath}}
  mountPoint: {{yamlQuote (printf "/mnt/macnas-mounts/%s" .ID)}}
  writable: {{.Writable}}
{{end}}
{{end}}
{{end}}

containerd:
  system: false
  user: false

provision:
- mode: system
  script: |
    #!/bin/bash
    set -eux -o pipefail
    export DEBIAN_FRONTEND=noninteractive

    # 1. 安装 Docker Engine 与 Samba
    if ! command -v docker >/dev/null 2>&1; then
      curl -fsSL https://get.docker.com | sh
    fi

    if ! command -v smbd >/dev/null 2>&1 || ! command -v sshd >/dev/null 2>&1; then
      apt-get update && apt-get install -y samba smbclient openssh-server
    fi

    # 2. 准备 /data 挂载与目录结构
    {{if .DataDiskName}}
    if [ -d {{shellQuote (printf "/mnt/lima-%s" .DataDiskName)}} ]; then
      mkdir -p {{shellQuote (printf "/mnt/lima-%s/media" .DataDiskName)}} {{shellQuote (printf "/mnt/lima-%s/files" .DataDiskName)}} {{shellQuote (printf "/mnt/lima-%s/downloads" .DataDiskName)}} {{shellQuote (printf "/mnt/lima-%s/photos" .DataDiskName)}} {{shellQuote (printf "/mnt/lima-%s/appdata/compose" .DataDiskName)}}
      chmod 0770 {{shellQuote (printf "/mnt/lima-%s" .DataDiskName)}} || true
      ln -sfn {{shellQuote (printf "/mnt/lima-%s" .DataDiskName)}} /data
    else
      mkdir -p /data/media /data/files /data/downloads /data/photos /data/appdata/compose
      chmod 0770 /data || true
    fi
    {{else}}
    mkdir -p /data/media /data/files /data/downloads /data/photos /data/appdata/compose
    chmod 0770 /data || true
    {{end}}

    # 3. 创建 VirtioFS bind mount 持久化 systemd 服务 (保证 VM 每次启动自动挂载)
    mkdir -p /mnt/macnas-mounts
    cat <<'MOUNT_SCRIPT' > /usr/local/bin/macnas-mounts.sh
    #!/bin/bash
    # MacNAS VirtioFS bind mount — 每次 VM 启动自动执行
    set -e
    for i in $(seq 1 30); do
      REAL_DATA="$(readlink -f /data || true)"
      if [ -n "$REAL_DATA" ] && [ -d "$REAL_DATA" ]; then
        break
      fi
      sleep 1
    done
    if [ -z "$REAL_DATA" ] || [ ! -d "$REAL_DATA" ]; then
      echo "[macnas-mounts] /data is not ready" >&2
      exit 1
    fi
    MOUNT_SCRIPT

    {{range .LocalMounts}}
    {{if .Enabled}}
    cat <<'ENTRY_END' >> /usr/local/bin/macnas-mounts.sh
    SOURCE_PATH={{shellQuote (printf "/mnt/macnas-mounts/%s" .ID)}}
    for i in $(seq 1 60); do
      if mountpoint -q "$SOURCE_PATH"; then
        break
      fi
      sleep 1
    done
    if ! mountpoint -q "$SOURCE_PATH"; then
      echo "[macnas-mounts] source is not ready: $SOURCE_PATH" >&2
      exit 1
    fi
    mount -o remount,{{if .Writable}}rw{{else}}ro{{end}} "$SOURCE_PATH" 2>/dev/null || true
    REAL_DATA="$(readlink -f /data || echo /data)"
    TARGET_DIR="${REAL_DATA}/"{{shellQuote .GuestTarget}}
    mkdir -p "$TARGET_DIR"
    if mountpoint -q "$TARGET_DIR"; then
      umount "$TARGET_DIR" 2>/dev/null || true
    fi
    if ! mountpoint -q "$TARGET_DIR"; then
      mount --bind "$SOURCE_PATH" "$TARGET_DIR"
      echo "[macnas-mounts] bind mounted {{shellQuote .ID}} -> $TARGET_DIR"
    fi
    mount -o remount,{{if .Writable}}rw{{else}}ro{{end}} "$TARGET_DIR" 2>/dev/null || true
    ENTRY_END
    {{end}}
    {{end}}

    chmod +x /usr/local/bin/macnas-mounts.sh

    cat <<'SERVICE_EOF' > /etc/systemd/system/macnas-mounts.service
    [Unit]
    Description=MacNAS VirtioFS bind mounts
    # Do not order this multi-user service after cloud-init.target/cloud-final.
    # Ubuntu's cloud-init target is itself ordered after multi-user.target;
    # adding the reverse edge creates a boot cycle and leaves limactl start
    # waiting forever for the guest readiness marker.
    After=local-fs.target docker.service

    [Service]
    Type=oneshot
    RemainAfterExit=yes
    ExecStart=/usr/local/bin/macnas-mounts.sh

    [Install]
    WantedBy=multi-user.target
    SERVICE_EOF

    systemctl daemon-reload
    systemctl enable macnas-mounts.service
    systemctl start macnas-mounts.service || true


    # 3. 配置 Samba
    cat <<'EOF' > /etc/samba/smb.conf
    [global]
       workgroup = WORKGROUP
       server string = MacNAS
       server role = standalone server
       security = user
       map to guest = Never
       dns proxy = no
       log file = /var/log/samba/log.%m
       max log size = 50

    [MacNAS]
       comment = MacNAS Data Share
       path = /data
       browseable = yes
       writable = yes
       read only = no
       guest ok = no
       create mask = 0660
       directory mask = 0770
       force user = macnas
       force group = macnas
    EOF

    # 4. 创建默认用户 macnas
    if ! getent group macnas >/dev/null 2>&1; then
      groupadd --system macnas
    fi
    id -u macnas &>/dev/null || useradd -M -g macnas -s /usr/sbin/nologin macnas

    # Lima executes management commands as macnasctl. Keep its supplementary
    # groups in the provisioned image so Docker and the NAS data volume are
    # accessible without requiring a root terminal.
    for group in docker macnas; do
      if getent group "$group" >/dev/null 2>&1; then
        usermod -aG "$group" macnasctl
      fi
    done
    chown macnas:macnas /data /data/media /data/files /data/downloads /data/photos /data/appdata 2>/dev/null || true
    chmod 0770 /data /data/media /data/files /data/downloads /data/photos /data/appdata 2>/dev/null || true

    systemctl restart smbd nmbd || true
    systemctl restart docker || true

    # 5. SSH is root-only for remote administration and never accepts a password.
    # Do not use AllowUsers here: Lima's internal management account also relies
    # on this sshd and must remain available to limactl shell.
    mkdir -p /etc/ssh/sshd_config.d /root/.ssh
    chmod 700 /root/.ssh
    cat <<'SSH_EOF' > /etc/ssh/sshd_config.d/99-macnas.conf
    Port 22
    PermitRootLogin prohibit-password
    PasswordAuthentication no
    KbdInteractiveAuthentication no
    ChallengeResponseAuthentication no
    PubkeyAuthentication yes
    AuthorizedKeysFile .ssh/authorized_keys .ssh/authorized_keys2
    SSH_EOF
    systemctl enable ssh 2>/dev/null || systemctl enable sshd 2>/dev/null || true
    systemctl restart ssh 2>/dev/null || systemctl restart sshd 2>/dev/null || true

probes:
- script: |
    #!/bin/bash
    set -eux -o pipefail
    command -v docker >/dev/null 2>&1
    pgrep dockerd >/dev/null 2>&1
    command -v smbd >/dev/null 2>&1
  hint: See "/var/log/cloud-init-output.log" in the guest

portForwards:
- guestSocket: "/var/run/docker.sock"
  hostSocket: "{{ "{{.Dir}}" }}/sock/docker.sock"
{{ $hostBindAddress := .HostBindAddress }}
{{range .ForwardedPorts}}
- guestPort: {{.}}
  hostIP: "{{$hostBindAddress}}"
  hostPort: {{.}}
{{end}}
{{if ne .SambaPort 0}}
- guestPort: 445
  hostIP: "{{.HostBindAddress}}"
  hostPort: {{.SambaPort}}
{{end}}
